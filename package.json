{
  "name": "@untrace/paperclip-plugin-content-calendar",
  "version": "0.2.0",
  "description": "Content calendar and publish scheduler for Paperclip. Reads social_post cases, renders them on a month grid, and publishes approved cases when due.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "exports": {
    ".": "./src/manifest.ts"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "verify:namespace": "node ./scripts/verify-namespace.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.821.0-canary.11"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "esbuild": "^0.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=22"
  }
}
