{
  "name": "@epic0x/paperclip-plugin-content-calendar",
  "version": "0.5.0",
  "description": "Content calendar and publish scheduler for Paperclip. Reads social_post cases, renders them on a month grid, and publishes approved cases when due.",
  "type": "module",
  "license": "MIT",
  "author": "Epic0x",
  "homepage": "https://github.com/epic0x/paperclip-content-calendar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epic0x/paperclip-content-calendar.git"
  },
  "bugs": {
    "url": "https://github.com/epic0x/paperclip-content-calendar/issues"
  },
  "keywords": [
    "paperclip",
    "paperclip-plugin",
    "content-calendar",
    "scheduler",
    "social"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "!**/*.map"
  ],
  "exports": {
    ".": "./dist/manifest.js"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "prepack": "npm run build",
    "dev": "node ./esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "verify:namespace": "node ./scripts/verify-namespace.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.821.0-canary.11"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "esbuild": "^0.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=22"
  }
}
